<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the live traffic graph: tap hides or shows it, long-press shows only it (LiveGraphsFragment). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="36dp"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingEnd="4dp">

    <View
        android:id="@+id/live_legend_dot"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/live_legend_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorPrimary"
        tools:text="Proxy" />

    <TextView
        android:id="@+id/live_legend_down"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:singleLine="true"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorPrimary"
        tools:text="1.25 MB/s" />

    <TextView
        android:id="@+id/live_legend_up"
        android:layout_width="88dp"
        android:layout_height="wrap_content"
        android:fontFeatureSettings="tnum"
        android:gravity="end"
        android:singleLine="true"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:textColor="?android:attr/textColorPrimary"
        tools:text="32.0 kB/s" />

</LinearLayout>
