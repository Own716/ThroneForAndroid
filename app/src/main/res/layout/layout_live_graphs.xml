<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".ui.LiveGraphsFragment">

    <include
        layout="@layout/layout_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/live_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <!-- The desktop's Traffic Graph tab -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="12dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:singleLine="true"
                            android:text="@string/live_graph_traffic"
                            android:textAppearance="?android:attr/textAppearanceMedium"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textStyle="bold" />

                        <com.google.android.material.button.MaterialButtonToggleGroup
                            android:id="@+id/live_range"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:selectionRequired="true"
                            app:singleSelection="true">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/live_range_1m"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="44dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="1m"
                                android:textAllCaps="false"
                                tools:ignore="HardcodedText" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/live_range_2m"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="44dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="2m"
                                android:textAllCaps="false"
                                tools:ignore="HardcodedText" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/live_range_5m"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="44dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="5m"
                                android:textAllCaps="false"
                                tools:ignore="HardcodedText" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/live_range_10m"
                                style="?attr/materialButtonOutlinedStyle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:minWidth="44dp"
                                android:paddingStart="4dp"
                                android:paddingEnd="4dp"
                                android:text="10m"
                                android:textAllCaps="false"
                                tools:ignore="HardcodedText" />

                        </com.google.android.material.button.MaterialButtonToggleGroup>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="4dp"
                        android:paddingEnd="4dp">

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="1dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/live_column_down"
                            android:layout_width="88dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:drawablePadding="6dp"
                            android:focusable="true"
                            android:gravity="center_vertical|end"
                            android:singleLine="true"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorSecondary"
                            tools:text="↓ Down" />

                        <TextView
                            android:id="@+id/live_column_up"
                            android:layout_width="88dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:drawablePadding="6dp"
                            android:focusable="true"
                            android:gravity="center_vertical|end"
                            android:singleLine="true"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorSecondary"
                            tools:text="↑ Up" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/live_legend"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/live_traffic_chart"
                        android:layout_width="match_parent"
                        android:layout_height="240dp"
                        android:layout_marginTop="8dp"
                        android:contentDescription="@string/live_graph_traffic" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/live_graph_legend_hint"
                        android:textAppearance="?android:attr/textAppearanceSmall"
                        android:textColor="?android:attr/textColorSecondary" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- The desktop's runtime CPU and RAM sparklines, for the service process that runs the core -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/live_graph_core_title"
                        android:textAppearance="?android:attr/textAppearanceMedium"
                        android:textColor="?android:attr/textColorPrimary"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_graph_cpu"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/live_cpu_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="2.4%" />

                    </LinearLayout>

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/live_cpu_chart"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/live_graph_cpu" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_graph_ram"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/live_ram_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="142 MB" />

                    </LinearLayout>

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/live_ram_chart"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/live_graph_ram" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/live_graph_connections"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorSecondary" />

                        <TextView
                            android:id="@+id/live_connections_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFeatureSettings="tnum"
                            android:textAppearance="?android:attr/textAppearanceSmall"
                            android:textColor="?android:attr/textColorPrimary"
                            tools:text="12" />

                    </LinearLayout>

                    <io.nekohasekai.sagernet.widget.LiveChartView
                        android:id="@+id/live_connections_chart"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_marginTop="2dp"
                        android:contentDescription="@string/live_graph_connections" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>
